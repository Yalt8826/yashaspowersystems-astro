# Cloudflare Pages reads this file from the BUILD OUTPUT directory.
# It lives in public/ so Astro copies it to dist/ verbatim.
# Limits: 100 rules max, 2000 characters per line.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Astro emits content-hashed filenames here, so they are safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800
